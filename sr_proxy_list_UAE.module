#!name=UAE OTT Bypass (VoIP & Video Call) 2026
#!desc=Gets past the TDRA firewall in the UAE, no more and no less: (1) VOICE & VIDEO CALLS over OTT apps (WhatsApp, FaceTime, Messenger, Viber, Zalo, Telegram, Signal, Discord, imo, Snapchat, LINE, KakaoTalk, WeChat) with IP-CIDR for their media servers (RTP/STUN/TURN), checked against BGP 09/2026; (2) the site groups TDRA blocks outright, verified from du and Etisalat on 2026-09-12 (adult, gambling, dating, VPN providers, some press); (3) public DNS. Services that open normally in the UAE (Google/YouTube/Netflix/X/TikTok, Teams/Meet/Skype, Akamai/CloudFront/Cloudflare CDNs) are deliberately left out — proxying them only slows the phone down. 2026-09-13: BGP re-checked (Meta AS32934, Telegram cidr.txt, VNG AS38244), proton.me dropped (Proton Mail opens normally), 2 duplicate qq.com rules removed.
#!homepage=https://github.com/kulinh/gfw-vnm

# ============================================================================
#  HOW TO USE (blacklist mode, while in the UAE)
#  1) Settings > Modules: add this module.
#  2) In your config (.conf) the LAST line of [Rule] must be:  FINAL,DIRECT
#     => the domains/IPs below go through PROXY, everything else goes direct.
#  3) If an app complains it detects a proxy: Settings > Proxy > none (TUN).
#  4) cf-vpn panel configs (RWL-UAE, &rules=uae) already inline every rule
#     below — no module needed there.
#  Important for VoIP: TDRA does not block the WhatsApp/Viber/Zalo... websites
#  (they all open), it blocks the VOICE CHANNEL: calls reach the media servers
#  by IP (STUN/TURN/RTP), so the IP-CIDR blocks below are REQUIRED.
#  Licensed in the UAE, so NO proxy needed: Botim, C'Me, Voico, Zoom, Microsoft
#  Teams, Google Meet, Webex. Consumer Skype shut down (05/2025).
#  Sources (09/2026): RIPEstat announced-prefixes AS32934 (Meta),
#  AS62014/62041/59930/44907/211157 (Telegram), AS38244 (VNG/Zalo); Apple
#  17.0.0.0/8 per Apple HT210060; HTTPS tests from du (AS15802) and Etisalat
#  (AS5384) via globalping.io on 2026-09-12.
# ============================================================================

[Rule]

# ============================================================================
#  GROUP 1 — OTT MESSAGING / VOICE & VIDEO CALLS  (the core for the UAE)
# ============================================================================

# ---------------------------- WhatsApp --------------------------------------
DOMAIN-SUFFIX,whatsapp.com,PROXY
DOMAIN-SUFFIX,whatsapp.net,PROXY
DOMAIN-SUFFIX,wa.me,PROXY

# ---------------------------- Facebook Messenger / Instagram call -----------
DOMAIN-SUFFIX,messenger.com,PROXY
DOMAIN-SUFFIX,m.me,PROXY
DOMAIN-SUFFIX,facebook.com,PROXY
DOMAIN-SUFFIX,facebook.net,PROXY
DOMAIN-SUFFIX,fbcdn.net,PROXY
DOMAIN-SUFFIX,fbsbx.com,PROXY
DOMAIN-SUFFIX,instagram.com,PROXY
DOMAIN-SUFFIX,cdninstagram.com,PROXY
DOMAIN-SUFFIX,meta.com,PROXY

# ---------------------------- FaceTime (Apple) ------------------------------
#   FaceTime/iMessage signalling only; App Store, iCloud and CDNs (mzstatic,
#   aaplimg) stay direct for speed. FaceTime's media relays sit in 17.0.0.0/8
#   (UDP 3478-3497, 16384-16387) — see the IP-CIDR block below.
DOMAIN-SUFFIX,facetime.apple.com,PROXY
DOMAIN-SUFFIX,ess.apple.com,PROXY
DOMAIN-SUFFIX,ids.apple.com,PROXY
DOMAIN-SUFFIX,push.apple.com,PROXY

# ---------------------------- Viber ----------------------------------------
DOMAIN-SUFFIX,viber.com,PROXY
DOMAIN-SUFFIX,viber.net,PROXY
DOMAIN-KEYWORD,viber,PROXY

# ---------------------------- Zalo (chat / calls / media) -----------------
DOMAIN-SUFFIX,zalo.me,PROXY
DOMAIN-SUFFIX,zaloapp.com,PROXY
DOMAIN-SUFFIX,zadn.vn,PROXY
DOMAIN-SUFFIX,zdn.vn,PROXY
DOMAIN-SUFFIX,dlfl.me,PROXY
DOMAIN-SUFFIX,dlfl.vn,PROXY
DOMAIN-SUFFIX,cscpdl.com,PROXY
DOMAIN-SUFFIX,cscfdl.com,PROXY
DOMAIN-SUFFIX,cscvdl.com,PROXY
DOMAIN-SUFFIX,cscvdlz.com,PROXY
DOMAIN-SUFFIX,social-dl.com,PROXY
DOMAIN-SUFFIX,social-dl-z.com,PROXY

# ---------------------------- Telegram (only calls are blocked) -----------
DOMAIN-SUFFIX,telegram.org,PROXY
DOMAIN-SUFFIX,telegram.me,PROXY
DOMAIN-SUFFIX,t.me,PROXY
DOMAIN-SUFFIX,telegra.ph,PROXY
DOMAIN-SUFFIX,tdesktop.com,PROXY
DOMAIN-SUFFIX,telesco.pe,PROXY
DOMAIN-SUFFIX,cdn-telegram.org,PROXY
DOMAIN-KEYWORD,telegram,PROXY

# ---------------------------- Signal ---------------------------------------
DOMAIN-SUFFIX,signal.org,PROXY
DOMAIN-SUFFIX,signal.art,PROXY
DOMAIN-SUFFIX,whispersystems.org,PROXY

# ---------------------------- Discord (web opens, OONI AE 4444/4633 OK; only voice is blocked) ---
DOMAIN-SUFFIX,discord.com,PROXY
DOMAIN-SUFFIX,discordapp.com,PROXY
DOMAIN-SUFFIX,discordapp.net,PROXY
DOMAIN-SUFFIX,discord.gg,PROXY
DOMAIN-SUFFIX,discord.media,PROXY

# ---------------------------- imo (web blocked on du, 2026-09-12) ---------
DOMAIN-SUFFIX,imo.im,PROXY

# ---------------------------- Snapchat (calls) ----------------------------
DOMAIN-SUFFIX,snapchat.com,PROXY
DOMAIN-SUFFIX,sc-cdn.net,PROXY
DOMAIN-SUFFIX,sc-prod.net,PROXY
DOMAIN-SUFFIX,sc-static.net,PROXY

# ---------------------------- LINE / KakaoTalk -----------------------------
DOMAIN-SUFFIX,line.me,PROXY
DOMAIN-SUFFIX,line-scdn.net,PROXY
DOMAIN-SUFFIX,line-apps.com,PROXY
DOMAIN-SUFFIX,kakao.com,PROXY
DOMAIN-SUFFIX,kakaocdn.net,PROXY

# ---------------------------- WeChat / Weixin ------------------------------
DOMAIN-SUFFIX,wechat.com,PROXY
DOMAIN-SUFFIX,wechatapp.com,PROXY
DOMAIN-SUFFIX,qq.com,PROXY
DOMAIN-SUFFIX,qpic.cn,PROXY
DOMAIN-SUFFIX,qlogo.cn,PROXY
DOMAIN-KEYWORD,wechat,PROXY

# ----------------------------------------------------------------------------
#  MEDIA SERVER IP-CIDR (RTP/STUN/TURN) — REQUIRED or calls drop
# ----------------------------------------------------------------------------
# --- Meta / AS32934 (WhatsApp, Messenger, Instagram) — BGP 09/2026 ---
IP-CIDR,31.13.24.0/21,PROXY,no-resolve
IP-CIDR,31.13.64.0/18,PROXY,no-resolve
IP-CIDR,45.64.40.0/22,PROXY,no-resolve
IP-CIDR,57.141.0.0/19,PROXY,no-resolve
IP-CIDR,57.144.0.0/14,PROXY,no-resolve
IP-CIDR,66.220.144.0/20,PROXY,no-resolve
IP-CIDR,69.63.176.0/20,PROXY,no-resolve
IP-CIDR,69.171.224.0/19,PROXY,no-resolve
IP-CIDR,74.119.76.0/22,PROXY,no-resolve
IP-CIDR,102.132.96.0/20,PROXY,no-resolve
IP-CIDR,103.4.96.0/22,PROXY,no-resolve
IP-CIDR,129.134.0.0/16,PROXY,no-resolve
IP-CIDR,157.240.0.0/16,PROXY,no-resolve
IP-CIDR,163.70.128.0/17,PROXY,no-resolve
IP-CIDR,163.77.132.0/23,PROXY,no-resolve
IP-CIDR,163.77.136.0/23,PROXY,no-resolve
IP-CIDR,173.252.64.0/18,PROXY,no-resolve
IP-CIDR,179.60.192.0/22,PROXY,no-resolve
IP-CIDR,185.60.216.0/22,PROXY,no-resolve
IP-CIDR,185.89.216.0/22,PROXY,no-resolve
IP-CIDR,204.15.20.0/22,PROXY,no-resolve
IP-CIDR6,2a03:2880::/32,PROXY,no-resolve
IP-CIDR6,2620:0:1c00::/40,PROXY,no-resolve
# --- Apple (FaceTime/iMessage relay + APNs) — all of 17.0.0.0/8 is Apple's.
#     If App Store / iCloud feel slow you may drop this line (FaceTime still needs it). ---
IP-CIDR,17.0.0.0/8,PROXY,no-resolve
# --- Telegram (calls reach datacenters / reflectors by IP) — BGP 09/2026 ---
IP-CIDR,91.105.192.0/23,PROXY,no-resolve
IP-CIDR,91.108.4.0/22,PROXY,no-resolve
IP-CIDR,91.108.8.0/22,PROXY,no-resolve
IP-CIDR,91.108.12.0/22,PROXY,no-resolve
IP-CIDR,91.108.16.0/22,PROXY,no-resolve
IP-CIDR,91.108.20.0/22,PROXY,no-resolve
IP-CIDR,91.108.56.0/22,PROXY,no-resolve
IP-CIDR,95.161.64.0/20,PROXY,no-resolve
IP-CIDR,149.154.160.0/20,PROXY,no-resolve
IP-CIDR,185.76.151.0/24,PROXY,no-resolve
IP-CIDR6,2001:67c:4e8::/48,PROXY,no-resolve
IP-CIDR6,2001:b28:f23c::/48,PROXY,no-resolve

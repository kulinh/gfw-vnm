IP-CIDR,45.127.252.0/22,PROXY,no-resolve
IP-CIDR,49.213.64.0/18,PROXY,no-resolve
IP-CIDR,58.84.0.0/22,PROXY,no-resolve
IP-CIDR,61.28.224.0/19,PROXY,no-resolve
IP-CIDR,103.196.236.0/22,PROXY,no-resolve
IP-CIDR,103.245.248.0/22,PROXY,no-resolve
IP-CIDR,118.102.0.0/21,PROXY,no-resolve
IP-CIDR,120.138.64.0/20,PROXY,no-resolve
IP-CIDR,122.201.8.0/21,PROXY,no-resolve
IP-CIDR6,2001:df0:13::/48,PROXY,no-resolve
IP-CIDR6,2001:df0:1a::/48,PROXY,no-resolve
IP-CIDR6,2402:4e0::/32,PROXY,no-resolve

# ============================================================================
#  GROUP 2 — SITES TDRA BLOCKS OUTRIGHT (verified from du + Etisalat 2026-09-12:
#  TLS handshake timeout / ECONNRESET / DNS timeout on both networks)
# ============================================================================
# --- Adult ---
DOMAIN-SUFFIX,pornhub.com,PROXY
DOMAIN-SUFFIX,pornhubpremium.com,PROXY
DOMAIN-SUFFIX,xvideos.com,PROXY
DOMAIN-SUFFIX,xnxx.com,PROXY
DOMAIN-SUFFIX,xhamster.com,PROXY
DOMAIN-SUFFIX,xhamster.desi,PROXY
DOMAIN-SUFFIX,youporn.com,PROXY
DOMAIN-SUFFIX,redtube.com,PROXY
DOMAIN-SUFFIX,chaturbate.com,PROXY
DOMAIN-SUFFIX,stripchat.com,PROXY
DOMAIN-SUFFIX,livejasmin.com,PROXY
DOMAIN-SUFFIX,onlyfans.com,PROXY
# --- Gambling / betting (fun88, w88 open normally -> not added) ---
DOMAIN-SUFFIX,bet365.com,PROXY
DOMAIN-SUFFIX,888.com,PROXY
DOMAIN-SUFFIX,pokerstars.com,PROXY
DOMAIN-SUFFIX,1xbet.com,PROXY
DOMAIN-SUFFIX,betway.com,PROXY
DOMAIN-SUFFIX,m88.com,PROXY
DOMAIN-SUFFIX,dafabet.com,PROXY
# --- Dating (tinder blocked on Etisalat only; hinge opens) ---
DOMAIN-SUFFIX,tinder.com,PROXY
DOMAIN-SUFFIX,gotinder.com,PROXY
DOMAIN-SUFFIX,badoo.com,PROXY
DOMAIN-SUFFIX,bumble.com,PROXY
DOMAIN-SUFFIX,okcupid.com,PROXY
DOMAIN-SUFFIX,grindr.com,PROXY
# --- VPN providers (their websites + app downloads) ---
#     proton.me (Proton Mail) is NOT blocked: OONI AE 01-09/2026 proton.me 424/426,
#     mail.proton.me 315/315 OK -> dropped; only protonvpn.com is blocked (76/89 failures).
DOMAIN-SUFFIX,nordvpn.com,PROXY
DOMAIN-SUFFIX,protonvpn.com,PROXY
DOMAIN-SUFFIX,expressvpn.com,PROXY
DOMAIN-SUFFIX,surfshark.com,PROXY
DOMAIN-SUFFIX,windscribe.com,PROXY
DOMAIN-SUFFIX,mullvad.net,PROXY
# --- Press ---
DOMAIN-SUFFIX,middleeasteye.net,PROXY

# ============================================================================
#  GROUP 3 — PUBLIC DNS (Etisalat also blocks at the DNS layer: lookups time out;
#  send DNS/DoH to Google & Cloudflare through the proxy so it is not poisoned)
# ============================================================================
DOMAIN-SUFFIX,cloudflare-dns.com,PROXY
DOMAIN,one.one.one.one,PROXY
IP-CIDR,8.8.8.0/24,PROXY,no-resolve
IP-CIDR,8.8.4.0/24,PROXY,no-resolve
IP-CIDR,1.1.1.1/32,PROXY,no-resolve
IP-CIDR,1.0.0.1/32,PROXY,no-resolve

# ============================================================================
#  LEFT OUT (verified 2026-09-12 from du + Etisalat: open normally, proxying
#  them only slows things down): google.com, youtube.com, googlevideo.com, netflix.com,
#  x.com/twitter.com, tiktok.com, threads.net, teams.microsoft.com,
#  meet.google.com, zoom.us, skype.com, wikipedia.org, reddit.com, twitch.tv,
#  aljazeera.com, bbc.com, ynet.co.il (Israel unblocked), archive.org,
#  binance.com, proton.me (mail; dropped 2026-09-13 per OONI); and the whole
#  akamai/cloudfront/amazonaws/cloudflare/fastly CDN group
#  (it would push half the Internet through the proxy, UAE sites included).
#  Want everything through the VPN? Use a full-tunnel config or global routing = Proxy.
# ============================================================================
